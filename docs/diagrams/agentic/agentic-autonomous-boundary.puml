' Agentic vs Autonomous boundary visualization
'
' Per CR-ES-004 §14 + ADR-ES-004 §9 + AG-INV-003 + AG-INV-010.
' Illustrates the foundational distinction between Agentic and Autonomous operation.
'
' Authored by: Emmanuel A. Otchere (cardinal author rule, 2026-09-23)

@startuml agentic-autonomous-boundary

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10

skinparam rectangle {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
}

title Agentic vs Autonomous Boundary

' Agentic (foundational)

package "Agentic ;;; Foundational" #FFE4B5 {
    rectangle "Delegated Intent" as a1
    rectangle "Contextual Interpretation" as a2
    rectangle "Action Selection" as a3
    rectangle "Bounded Authority" as a4
    rectangle "Goal-Directed Execution" as a5
}

note bottom of "Agentic ;;; Foundational"
  Per ADR-ES-004 §9:
  ;; Agentic operation emphasizes:
  ;; - delegated intent
  ;; - action selection
  ;; - contextual interpretation
  ;; - bounded authority
  ;; - goal-directed execution
end note

' Autonomous (advanced ;;; separately governed)

package "Autonomous ;;; Advanced (Separately Governed)" #E0E8F0 {
    rectangle "Self-Direction" as au1
    rectangle "Self-Management" as au2
    rectangle "Self-Adaptation" as au3
    rectangle "Reduced External Intervention" as au4
    rectangle "Sustained Independent Operation" as au5
}

note bottom of "Autonomous ;;; Advanced (Separately Governed)"
  Per ADR-ES-004 §9 + AG-INV-010:
  ;; Autonomy requires separate
  ;; semantic grounding
  ;; (governed by ADR-ES-007)
  ;;
  ;; NOT implied by Agentic
end note

' Boundary marker

rectangle "AG-INV-003 ;;; Agentic != Autonomous" as boundary #FFB6C1

' Relationship: Agentic may evolve toward Autonomous

a5 --> boundary
boundary --> au1 : may evolve toward ;;; separately governed

note right of boundary
  Per CR-ES-004 §14:
  ;; Agentic may operate with
  ;; limited autonomy ;;; but
  ;; limited autonomy does NOT
  ;; make an Agentic construct
  ;; semantically equivalent
  ;; to Autonomous
end note

@enduml