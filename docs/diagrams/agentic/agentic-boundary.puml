' Agentic vs Automation boundary visualization
'
' Per CR-ES-004 §12 + ADR-ES-004 §8 + AG-INV-002.
' Contrasts the 6 Agentic characteristics with conventional automation.
'
' Authored by: Emmanuel A. Otchere (cardinal author rule, 2026-09-23)

@startuml agentic-boundary

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10

skinparam rectangle {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
}

title Agentic vs Automation Boundary ;;; 6 Characteristics Required

' Conventional automation (left side)

package "Conventional Automation" {
    rectangle "Trigger" as t1 #E6E6FA
    rectangle "Predefined Rule" as t2 #E6E6FA
    rectangle "Predefined Action" as t3 #E6E6FA

    t1 --> t2
    t2 --> t3
}

note bottom of "Conventional Automation"
  Per ADR-ES-004 §8:
  ;; Automation executes predefined
  ;; logic without contextual
  ;; action selection
end note

' Agentic operation (right side)

package "Agentic Operation" {
    rectangle "Delegated Intent" as a1 #FFE4B5
    rectangle "Context" as a2 #FFE4B5
    rectangle "Interpretation" as a3 #FFE4B5
    rectangle "Action Selection" as a4 #FFFACD
    rectangle "Execution" as a5 #FFE4E1
    rectangle "Outcome" as a6 #E0FFE0

    a1 --> a2
    a2 --> a3
    a3 --> a4
    a4 --> a5
    a5 --> a6
}

note bottom of "Agentic Operation"
  Per ADR-ES-004 §4.1:
  ;; 6 characteristics present:
  ;; 1. delegated intent
  ;; 2. contextual interpretation
  ;; 3. action selection
  ;; 4. bounded authority
  ;; 5. execution
  ;; 6. outcome orientation
end note

' Adaptation loop

rectangle "Contextual Adaptation" as loop #F0FFF0

a6 --> loop : outcome observed
loop --> a4 : adapt selection

@enduml