' Agentic Enterprise boundary visualization
'
' Per CR-ES-010 §20 + ADR-ES-010 §1 + §3 + §8.
' Illustrates the Agentic Enterprise boundary against adjacent constructs.
'
' Authored by: Emmanuel A. Otchere (cardinal author rule, 2026-09-24)

@startuml agentic-enterprise-boundary

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam rectangle {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
    FontColor #000000
}

skinparam arrow {
    Color #2F4F4F
    FontColor #2F4F4F
}

title Agentic Enterprise ,  Boundary Distinctions

rectangle "Agentic Enterprise" as ae #FFE4B5

rectangle "Enterprise" as enterprise #E0E8F0
rectangle "AI Enterprise" as ai #FFE4E1
rectangle "Autonomous Enterprise" as autonomous #FFE4E1
rectangle "Autonomous Operations" as aops #FFFACD
rectangle "Agentic Operations" as agentic_ops #E6E6FA
rectangle "Agentic Value Stream" as avs #E0FFFF
rectangle "Agentic Workflow" as awf #F0FFF0
rectangle "Automation" as automation #C8C8C8

enterprise -[#4682B4]- ae : specialises
ae -[#888888]- ai : AE-NEG-001 (NOT)
ae -[#888888]- autonomous : AE-NEG-003 (NOT)
ae -[#888888]- aops : AE-NEG-011 (NOT)
ae -[#888888]- avs : AE-NEG-012 (NOT)
ae -[#888888]- awf : AE-NEG-013 (NOT)
ae -[#888888]- automation : AE-CON-011 (NOT sufficient)
ae -[#888888]- agentic_ops : AE-CON-005 (operates-through)

note bottom of ae
  Per AE-CON-002 + AE-CON-013 + AE-CON-014:
  Agentic Enterprise is established by material
  agentic participation at the enterprise boundary,
  not by possessing Agents (AE-NEG-007),
  not by using automation (AE-NEG-008),
  not by eliminating humans (AE-NEG-009),
  not by unlimited authority (AE-NEG-010).
end note

@enduml
