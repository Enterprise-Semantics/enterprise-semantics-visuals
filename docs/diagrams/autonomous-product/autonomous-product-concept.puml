@startuml autonomous-product-concept
title Autonomous Product Concept ; per ADR-ES-017 + CR-ES-017

skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment center

abstract class "Product" as P {
  +product_intent
  +product_value
}

class "Autonomous Product" as AP {
  +autonomy_scope
  +material_autonomous_progression
  +authority_context
  +policy_context
  +constraint_context
  +governance_context
  +adaptation_scope
}

P <|-- AP : specializes

class "Authority" as Auth
class "Policy" as Pol
class "Constraint" as Con
class "Governance" as Gov
class "Outcome" as O
class "Context" as Ctx
class "Objective" as Obj
class "Escalation" as Esc

AP --> Auth : operates-within
AP --> Pol : governed-by
AP --> Con : constrained-by
AP --> Gov : operates-within
AP --> Obj : pursues
AP --> Ctx : responds-to
AP --> O : produces
AP --> Ctx : adapts-to
AP --> Esc : escalates-to

note right of AP
  Autonomous Materiality required per ADR-ES-017 §5.
  AI NOT required per ADR-ES-017 §9.
  Automation NOT sufficient per ADR-ES-017 §10.
  Human participation remains compatible per ADR-ES-017 §6.
  Bounded by 6 fences: Objective -> Authority -> Policy -> Constraints -> Governance -> Escalation.
end note

@enduml
