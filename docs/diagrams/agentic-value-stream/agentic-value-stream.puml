' Agentic Value Stream relational diagram
'
' Per CR-ES-005 §17 + ADR-ES-005 §7 + §16.
' Illustrates the 5 canonical relationships:
' AgenticValueStream -|>- ValueStream (specializes)
' AgenticValueStream "1" *-- "1..*" ValueStage (contains)
' AgenticValueStream --> "1" --> StakeholderValue (realizes)
' AgenticValueStream --> "1..*" Agent (engages)
' AgenticValueStream --> "1..*" ValueStage (agent-realizes)
'
' Authored by: Emmanuel A. Otchere (cardinal author rule, 2026-09-23)

@startuml agentic-value-stream

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam rectangle {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
}

skinparam arrow {
    Color #2F4F4F
}

title Agentic Value Stream ;; Specialisation of Value Stream

rectangle "Agentic Value Stream" as avs #FFE4B5

rectangle "Value Stream" as vs #F0FFF0
rectangle "Value Stage" as vstage #FFFACD
rectangle "Stakeholder Value" as sv #E0FFE0
rectangle "Agent" as agent #F0E8FF

rectangle "Intent" as intent #F5F5DC
rectangle "Authority" as authority #E0FFFF
rectangle "Action" as action #FFE4E1
rectangle "Outcome" as outcome #F0FFF0

avs -|> vs : specialises
avs "1" *-- "1..*" vstage : contains
avs --> sv : realises
avs "1" *-- "1..*" agent : engages
avs "1" *-- "1..*" vstage : agent-realises

agent --> intent : interprets
agent --> authority : acts-within
agent --> action : selects
agent --> action : coordinates
agent --> outcome : produces

@enduml